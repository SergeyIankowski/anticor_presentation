{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Website harvest",
  "type": "object",
  "required": ["metadata", "company", "services", "pages", "sources"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["source_site", "brand", "retrieved_at"],
      "properties": {
        "source_site": { "type": "string", "format": "uri" },
        "brand": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "company": { "type": "object" },
    "services": { "type": "array", "minItems": 1 },
    "pages": { "type": "array", "minItems": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } } } }
  }
}
